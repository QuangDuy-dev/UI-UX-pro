{
  // appsettings.Example.json — BẢN MẪU, KHÔNG CHỨA BÍ MẬT THẬT.
  // Copy sang appsettings.json để chạy local, hoặc set thẳng ENV VARS trên Render
  // (không cần file này trên server). Env var dùng dấu "__" thay cho ":":
  //
  //   ConnectionStrings__MongoDb    = ConnectionStrings:MongoDb
  //   MongoDb__DatabaseName         = MongoDb:DatabaseName
  //   AdminSettings__SecretRoute    = AdminSettings:SecretRoute
  //   AdminSettings__MasterPassword = AdminSettings:MasterPassword
  //   AdminSettings__CookieName     = AdminSettings:CookieName
  //   AdminSettings__CookieHours    = AdminSettings:CookieHours
  //   ApiSecurity__AgentKey         = ApiSecurity:AgentKey
  //   Ai__Enabled                   = Ai:Enabled
  //   Ai__ApiKey                    = Ai:ApiKey
  //   Ai__Endpoint                  = Ai:Endpoint
  //   Ai__Model                     = Ai:Model
  //   Ai__MaxItemsPerRun            = Ai:MaxItemsPerRun
  //   DailyTrend__MaxItemsPerRun    = DailyTrend:MaxItemsPerRun
  //   DailyTrend__DefaultKeywords   = DailyTrend:DefaultKeywords (chuỗi JSON array, vd "[\"glassmorphism\",\"neumorphism\"]")

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MongoDb": "mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0"
  },
  "MongoDb": {
    "DatabaseName": "uianimationdb"
  },
  "AdminSettings": {
    "SecretRoute": "THAY-DOI-ROUTE-BI-MAT",
    "MasterPassword": "THAY-DOI-MAT-KHAU-ADMIN",
    "CookieName": "UIAnimate_AdminAuth",
    "CookieHours": 12
  },
  "ApiSecurity": {
    "AgentKey": ""
  },
  "Ai": {
    "Enabled": true,
    "Provider": "deepseek",
    "ApiKey": "",
    "Endpoint": "https://api.deepseek.com/v1/chat/completions",
    "Model": "deepseek-v4-flash",
    "MaxItemsPerRun": 5
  },
  "DailyTrend": {
    "MaxItemsPerRun": 5,
    "DefaultKeywords": [
      "glassmorphism",
      "neumorphism",
      "gradient mesh",
      "micro-interaction",
      "3d tilt",
      "scroll reveal",
      "dark mode",
      "skeleton",
      "kinetic typography",
      "brutalism",
      "bento grid",
      "aurora",
      "particles",
      "neon glow",
      "marquee",
      "duotone",
      "glitch",
      "terminal",
      "isometric"
    ]
  }
}
