@model List<AnimationItem>
@{
    ViewData["Title"] = "Gallery";
    var cats = ViewData["Categories"] as List<Category> ?? new List<Category>();
    var current = ViewData["CurrentCategory"] as string ?? "all";
    var query = ViewData["CurrentQuery"] as string ?? "";
    var sort = ViewData["CurrentSort"] as string ?? "newest";
    var total = (long)(ViewData["TotalItems"] ?? 0);
    var currentPage = (int)(ViewBag.Page ?? 1);
    var pageSize = 12;
    var totalPages = (int)Math.Max(1, Math.Ceiling(total / (double)pageSize));
    var prevPage = currentPage - 1;
    var nextPage = currentPage + 1;
}

<section class="gallery-hero">
    <div class="container">
        <p class="hero-eyebrow">✦ UI/UX TREND COMPONENTS</p>
        <h1>Animated UI elements,<br /><span class="grad-text">ready to copy-paste.</span></h1>
        <p class="hero-sub">Hàng trăm component HTML/CSS/JS cho mọi phần tử web — cập nhật mỗi ngày từ xu hướng thiết kế hiện tại.</p>

        <form class="search-bar" method="get" asp-controller="Home" asp-action="Index">
            <input type="hidden" name="category" value="@current" />
            <input type="hidden" name="sort" value="@sort" />
            <input class="search-input" type="search" name="q" value="@query"
                   placeholder="Tìm kiếm: navbar, gradient, button, card, loader…" autocomplete="off" />
            <button class="search-btn" type="submit">Search</button>
        </form>
    </div>
</section>

<section class="container">
    <div class="toolbar">
        <div class="chips">
            <a class="chip @(current == "all" ? "active" : "")" asp-controller="Home" asp-action="Index"
               asp-route-q="@query" asp-route-sort="@sort">All</a>
            @foreach (var c in cats)
            {
                <a class="chip @(current == c.Slug ? "active" : "")" asp-controller="Home" asp-action="Index"
                   asp-route-category="@c.Slug" asp-route-q="@query" asp-route-sort="@sort">
                    @c.Icon @c.Name
                </a>
            }
        </div>
        <div class="toolbar-right">
            <span class="count-badge">@total components</span>
            <select class="sort-select" onchange="location = this.value;">
                @{
                    var catParam = current == "all" ? null : current;
                    var qParam = string.IsNullOrEmpty(query) ? null : query;
                }
                <option value="@Url.Action("Index", "Home", new { category = catParam, q = qParam, sort = "newest" })" selected="@(sort == "newest")">Newest</option>
                <option value="@Url.Action("Index", "Home", new { category = catParam, q = qParam, sort = "popular" })" selected="@(sort == "popular")">Most viewed</option>
                <option value="@Url.Action("Index", "Home", new { category = catParam, q = qParam, sort = "liked" })" selected="@(sort == "liked")">Most liked</option>
                <option value="@Url.Action("Index", "Home", new { category = catParam, q = qParam, sort = "name" })" selected="@(sort == "name")">Name A–Z</option>
            </select>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-emoji">🫥</div>
            <h3>Không tìm thấy component nào</h3>
            <p>Thử từ khoá khác hoặc upload component đầu tiên của bạn.</p>
            <a class="btn-upload big" asp-controller="Upload" asp-action="Index">＋ Upload component</a>
        </div>
    }
    else
    {
        <div class="grid">
            @foreach (var item in Model)
            {
                <partial name="_AnimationCard" model="item" />
            }
        </div>

        @if (totalPages > 1)
        {
            <nav class="pager">
                @if (currentPage > 1)
                {
                    <a class="page-btn" asp-controller="Home" asp-action="Index"
                       asp-route-category="@(current == "all" ? null : current)" asp-route-q="@(string.IsNullOrEmpty(query) ? null : query)"
                       asp-route-sort="@sort" asp-route-page="@prevPage">← Prev</a>
                }
                <span class="page-info">@currentPage / @totalPages</span>
                @if (currentPage < totalPages)
                {
                    <a class="page-btn" asp-controller="Home" asp-action="Index"
                       asp-route-category="@(current == "all" ? null : current)" asp-route-q="@(string.IsNullOrEmpty(query) ? null : query)"
                       asp-route-sort="@sort" asp-route-page="@nextPage">Next →</a>
                }
            </nav>
        }
    }
</section>
